.idea/
.vscode/
*.swp
*.swo

# Gunicorn
gunicorn.ctl

# Git worktrees
.worktrees/
.claude/worktrees/

# Claude Code per-instance overrides (env, permissions, hooks)
.claude/settings.local.json

# cannobserv package index mirror (#220) — populated by scripts/sync_wheelhouse.py.
# Track an empty .gitkeep so the `[tool.uv] find-links` dir always exists at
# checkout: every `uv` invocation reads that config before the sync can create
# the dir, so a fresh clone/runner/deploy without it fails to resolve.
# NB: `.wheelhouse/*`, not `.wheelhouse/` — git cannot re-include a file whose
# parent directory is excluded, so a directory-level ignore makes the negation
# below a no-op and leaves .gitkeep untracked (#239).
.wheelhouse/*
!.wheelhouse/.gitkeep

# Tailwind
src/dashboard/static/css/output.css

# Generated vendor-layer wrappers (built from vendor/*.min.css; see docs/STYLE.md §14)
src/dashboard/static/css/vendor/*.layered.css
