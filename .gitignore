.claude/settings.local.json

# brainstorming visual companion sessions (#396): --project-dir writes the
# session key (.last-token) and mockups here. Guarded by
# tests/test_brainstorm_session_is_not_committable.py.
.superpowers/

# The retired cannobserv wheelhouse (#358). Nothing reads it; the deploy
# checkout keeps its files until part 1 has been through a restart (the
# rollback's refill). Drop this line when they go.
.wheelhouse/

# Tailwind
src/dashboard/static/css/output.css

# Generated vendor-layer wrappers (built from vendor/*.min.css; see docs/STYLE.md §14)
src/dashboard/static/css/vendor/*.layered.css
