[Unit]
Description=Watcher database dump to GCS - nightly, create-only, holds no database credential (#296)
# Not bound to watcher.service: the artifact is the database, and a stopped
# service still has one worth shipping. After postgresql so a boot-time catch-up
# run (Persistent=true on the timer) does not race the server.
After=network-online.target postgresql.service tailscaled.service
Wants=network-online.target

[Service]
Type=oneshot
# root, for one reason: the GCS writer key is 0400 root:root. Everything the job
# does to the database it does as `postgres`, dropped to with setpriv, over the
# local socket with peer auth — so no database credential exists for it at all.
User=root
WorkingDirectory=/home/exedev/watcher

# WATCHER_BACKUP_BUCKET and GOOGLE_APPLICATION_CREDENTIALS (the writer key).
# NOT /etc/watcher/.env: that file carries the database URLs and the bus URL,
# none of which this unit needs and all of which it must not have. And never
# /etc/watcher/notifier.env, which is watcher.service's alone (#278). No leading
# '-': a backup unit without its configuration must fail loudly.
EnvironmentFile=/etc/watcher/backup.env
# WATCHER_BACKUP_NOTIFIER_BASE_URL, _MONITOR_ID and _NOTIFIER_API_KEY, 0400
# root:root (#296 D9) — all three or none. Optional only until the monitor
# exists: without it the job warns that a stopped backup will not be noticed,
# and still ships.
EnvironmentFile=-/etc/watcher/backup-notifier.env

# The sandbox. A read-only filesystem but for a private /tmp (the dump is
# written there, through an fd this process opens); no new privileges.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
# The local socket for pg_dump, and IP for GCS and the notifier check-in.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Three capabilities, each used: DAC_READ_SEARCH to read the venv under the
# 0750 home; SETUID/SETGID for setpriv to drop to postgres. They are AMBIENT as
# well because under systemd 255 any of the seccomp-backed protections above,
# beside NoNewPrivileges=yes, strips CAP_SETUID from the effective set before
# the exec — setpriv then fails setresuid with EPERM (found on the VM, pinned in
# tests/deploy/test_backup_units.py). The postgres child holds none at all.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_SETUID CAP_SETGID
# The tree is read-only to this unit anyway; say so rather than let Python try.
Environment=PYTHONDONTWRITEBYTECODE=1

# ~20 MB after retention (#296 D7). An hour is generous for the dump and the
# upload, and short enough that a wedged run is a failed unit, not a hang.
TimeoutStartSec=3600

# The venv's interpreter directly rather than `uv run`: uv wants a writable
# cache and may sync the environment, both refused by the sandbox (broker#4).
ExecStart=/home/exedev/watcher/.venv/bin/python -m src.ops.backup --database watcher --run-as postgres
