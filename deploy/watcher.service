[Unit]
Description=Watcher — Cannabis Observer monitoring service
After=network.target postgresql.service

[Service]
Type=simple
User=exedev
WorkingDirectory=/home/exedev/watcher

# Create runtime dir (runs as root before User= takes effect with + prefix)
ExecStartPre=+/bin/bash -c 'mkdir -p /run/watcher && chown exedev:exedev /run/watcher'

# Write current git SHA to a runtime env file before starting
ExecStartPre=/bin/bash -c 'echo BUILD_ID=$(git rev-parse --short HEAD) > /run/watcher/build-id'

# Refresh the cannobserv wheelhouse before `uv run` resolves co-core (#220).
# Non-fatal (- prefix): a transient GCS failure is logged but does not block a
# restart when the wheelhouse is already populated; only a genuinely missing
# wheel surfaces later as a hard uv resolution error. Reads
# GOOGLE_APPLICATION_CREDENTIALS from the EnvironmentFile above.
ExecStartPre=-/usr/local/bin/uv run --no-project --with 'google-cloud-storage>=2,<4' python /home/exedev/watcher/scripts/sync_wheelhouse.py

# Load BUILD_ID, then system secrets, then optional repo-local overrides
EnvironmentFile=-/run/watcher/build-id
EnvironmentFile=/etc/watcher/.env
EnvironmentFile=-/home/exedev/watcher/.env

# Production-database opt-in for src/core/db_safety (#233). Must live HERE,
# never in an EnvironmentFile — env files are sourced by hand-run servers,
# which are exactly what the guard exists to stop.
Environment=WATCHER_ALLOW_PRODUCTION_DB=1

# --log-config routes uvicorn's own loggers (uvicorn, uvicorn.access,
# uvicorn.error — all propagate=False with plain-text handlers by default)
# through the same JSON formatter as the app, so journald gets one format
# instead of plain-text access lines interleaved with JSON records (#244).
# The path is relative to WorkingDirectory= above (kept relative to match
# scripts/dev_server.sh and the docs) — running this line from another
# directory by hand fails at boot with a missing-file error.
ExecStart=/usr/local/bin/uv run uvicorn src.api.main:app --host 0.0.0.0 --port 8000 --log-config src/core/log_config.json
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
